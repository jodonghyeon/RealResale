{
  "name": "realresale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A secondhand marketplace with platform-generated photogrammetry scans.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server.js",
    "build": "vite build",
    "check": "node --check server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
